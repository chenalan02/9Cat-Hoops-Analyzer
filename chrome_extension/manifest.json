{
  "manifest_version": 3,
  "name": "9-Cat Hoops Live Draft Analyzer",
  "version": "1.0.0",
  "description": "Real-time 9-category fantasy basketball draft overlay, punt strategy z-scores, and live pick recommendations.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.fantasysports.yahoo.com/*",
    "*://*.espn.com/fantasy/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "9-Cat Draft Analyzer Setup"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fantasysports.yahoo.com/*",
        "*://*.espn.com/fantasy/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "engine/playerData.js",
        "engine/zscoreEngine.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ]
    }
  ]
}
